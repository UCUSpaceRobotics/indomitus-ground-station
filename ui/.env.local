# Local overrides for the ground station UI. Gitignored via `*.local`.

# CompressedImage over rosbridge, not web_video_server MJPEG.
#
# The mast ArduCam B0495 is published by gscam inside rover_prod on the Jetson
# (started with ~/start-gscam.sh) as /camera/mast/image_raw, which
# image_transport gives a /compressed companion -- exactly what this mode
# reads, and what the "Mast Pan/Tilt" tile (cam4) is already configured for.
#
# `mjpeg` has nothing to talk to: web_video_server is in neither image. The
# fallback for that path is ~/arducam_mjpeg.py on the rover (a non-ROS shim on
# 10.42.0.1:8080), which cannot run at the same time as gscam -- V4L2 streaming
# is exclusive, so only one of them may hold /dev/video0.
VITE_VIDEO_MODE=ros

# rosbridge runs in the indomitus_ground_station container on this PC with host
# networking, so the default (ws://<page host>:9090) is already correct.
