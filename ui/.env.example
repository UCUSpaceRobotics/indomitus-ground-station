# Optional build-time overrides for the ground station UI.
# Copy to `.env.local` and edit. Everything here has a sensible default that is
# derived from the host the page is served from, so this file is only needed
# when the UI and the rover are not reachable at the same hostname.

# rosbridge_server websocket. Default: ws://<page host>:9090
# VITE_ROSBRIDGE_URL=ws://192.168.1.50:9090

# web_video_server base URL. Default: http://<page host>:8080
# VITE_VIDEO_SERVER_URL=http://192.168.1.50:8080

# Camera transport: "mjpeg" (web_video_server) or "ros" (CompressedImage over
# rosbridge). Default: mjpeg
#
# Use "ros" against the real rover today: the ZED2i wrapper already publishes
# `/zed2i/rgb/image_rect_color/compressed` (~37 KB/frame at ~10 Hz), and
# `web_video_server` is not installed in the container image, so "mjpeg" has
# nothing to talk to until it is.
# VITE_VIDEO_MODE=ros
