# Machine-local overrides for docker compose (auto-read from the repo root).
#
# The three console boards are identical CH340 devices, so /dev/ttyACM* ordering
# is whatever order the kernel enumerated them in and it changes across reboots
# and replugs. Address them by their USB serial instead, which does not move.
#
#   ...5735001711 -> joystick board (3 sticks + 9 switches, 921600)
#   ...5734043794 -> button board   (23 switches, 115200)
JOY_BOARD_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5735001711-if00
BUTTON_BOARD_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5734043794-if00

# Must match the rover: its nodes run on domain 42.
ROS_DOMAIN_ID=42
