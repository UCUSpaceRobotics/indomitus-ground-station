<?xml version="1.0" encoding="UTF-8"?>
<!--
  GENERATED by docker/gen-dds-profile.sh — do not edit by hand.
  Rover link address: 10.44.0.10 (probe: 10.42.0.0)
  Discovery peers:    239.255.0.1:29900 (local, domain 90), 10.42.0.1 (rover)
  Peer participant ID range: 0..49

  Restricts UDP to the rover link so Fast DDS stops announcing locators the
  rover cannot route to. Shared memory is kept alongside it: the ground station
  container talks to a same-host rover_dev/Gazebo container over SHM, and
  dropping the builtin transports without re-adding it would break that.

  initialPeersList adds a unicast peer for the rover, because the mast Pi
  routes between the GS PC and the rover and multicast SPDP does not cross a
  router. The multicast locator is repeated explicitly because defining this
  list replaces Fast DDS's default instead of adding to it, and dropping it
  breaks discovery between the nodes running on this machine.

  127.0.0.1 is whitelisted alongside the link address so that multicast
  locator actually works locally; without it the ground station's own nodes
  are invisible to each other.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>rover_link_udp</transport_id>
        <type>UDPv4</type>
        <!-- Participant IDs probed per portless initial peer. The default of 4
             silently truncates discovery to the rover's first four
             participants. -->
        <maxInitialPeersRange>50</maxInitialPeersRange>
        <interfaceWhiteList>
          <address>10.44.0.10</address>
          <!-- Loopback is not optional. The whitelist applies to the multicast
               SPDP send/listen locators too, so with the link address alone the
               ground station's own nodes never see each other: topic data still
               flows (they discover the sim/rover over SHM), but `ros2 node
               list`, `ros2 service list` and the UI's calibration service
               calls all come back empty. -->
          <address>127.0.0.1</address>
        </interfaceWhiteList>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>local_shm</transport_id>
        <type>SHM</type>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="rover_link" is_default_profile="true">
      <rtps>
        <builtin>
          <initialPeersList>
            <!-- Keeps node-to-node discovery working on this machine. -->
            <locator>
              <udpv4>
                <address>239.255.0.1</address>
                <port>29900</port>
              </udpv4>
            </locator>
            <!-- Reaches the rover, which multicast cannot: the mast Pi routes. -->
            <locator>
              <udpv4>
                <address>10.42.0.1</address>
              </udpv4>
            </locator>
          </initialPeersList>
        </builtin>
        <userTransports>
          <transport_id>rover_link_udp</transport_id>
          <transport_id>local_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
